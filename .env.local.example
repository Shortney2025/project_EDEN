# Copy to .env.local and replace with your tokens
# Storyblok access token (preview or public as appropriate)
STORYBLOK_API_TOKEN=YOUR_STORYBLOK_API_TOKEN
# Optional Storyblok extras
STORYBLOK_SPACE_ID=YOUR_SPACE_ID
STORYBLOK_PREVIEW_TOKEN=YOUR_PREVIEW_TOKEN
# Example: path to a local se4l model file (if you pretrain and save one)
SE4L_MODEL_PATH=se4l_model.h5
